// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}


enum ModuleType {
  LESSON
  REVISION
  QUIZ
  FINAL_QUIZ
}

enum ContentType {
  VIDEO
  PDF
  DOCUMENT
  ASSIGNMENT
  LINK
}

enum DurationUnit {
  Days
  Weeks
  Months
  Years
}

enum RevisionContentType {
  VIDEO
  PDF
}

enum UserRole {
  SUPER_ADMIN
  SCHOOL_ADMIN
  STUDENT
  PARENT
}

enum CourseStatus {
  Draft
  Published
  Archived
}

enum Difficulty {
  Easy
  Medium
  Difficult
  Challenging
}

enum BloomLevel {
  Remember
  Understand
  Apply
  Analyze
  Evaluate
  Create
}

enum QuestionType {
  Conceptual
  Prediction
  Debugging
  ProblemSolving
}

enum InputMode {
  text
  image
}

enum SubscriptionStatus {
  active
  trial
  expired
}

// ============================================================
// EXAM ENUMS
// ============================================================

enum ExamType {
  MOCK
  FINAL
}

enum ExamStatus {
  Active
  Inactive
  Draft
  Archived
}

enum ExamDifficulty {
  Easy
  Medium
  Difficult
  Challenging
}

enum ExamQuestionType {
  Conceptual
  Prediction
  Debugging
  ProblemSolving
}

enum ExamBloomLevel {
  Remember
  Understand
  Apply
  Analyze
  Evaluate
  Create
}

enum ExamInputMode {
  text
  image
  code
}

// ============================================================
// MODELS
// ============================================================

model School {
  id           String            @id @default(cuid())
  name         String             @unique
  adminName    String
  adminEmail   String             @unique
  phone        String
  address      String
  region       String
  state        String
  students     Int                @default(0)
  active       Boolean            @default(true)
  subscription SubscriptionStatus @default(trial)
  performance  Int                @default(0)
  password     String
  role         UserRole           @default(SCHOOL_ADMIN)
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  @@map("schools")
}

model CourseLevel {
  id        String   @id @default(cuid())
  name      String   @unique
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  categories CourseCategory[]
  courses    Courses[]

  @@map("course_levels")
}

model CourseDurationType {
  id        String       @id @default(cuid())
  value     Int          @default(1)
  unit      DurationUnit @default(Months)
  sortOrder Int          @default(0)
  isActive  Boolean      @default(true)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  categories CourseCategory[]
  courses    Courses[]

  @@unique([value, unit])
  @@map("course_duration_types")
}

model ValidityPeriod {
  id        String    @id @default(cuid())
  name      String   @unique
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("validity_periods")
}

model Grade {
  id        String    @id @default(cuid())
  name      String   @unique
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  courses CourseGrade[]

  @@map("grades")
}

model CourseCategory {
  id                 String    @id @default(cuid())
  name               String
  code               String    @unique
  description        String?
  color              String    @default("#49205E")
  icon               String?
  categoryLogo       String?
  categoryBackground String?
  isDraft            Boolean   @default(false)
  isActive           Boolean   @default(true)
  synced             Boolean   @default(false)
  syncedAt           DateTime?
  createdBy          String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  levelId        String?
  level          CourseLevel?        @relation(fields: [levelId], references: [id])
  durationTypeId String?
  durationType   CourseDurationType? @relation(fields: [durationTypeId], references: [id])

  courses Courses[]

  @@map("course_categories")
}

// ============================================================
// CERTIFICATE TEMPLATE
// One template per Course. Matches the frontend certificate
// builder exactly — no award category, pass threshold, or
// grade tiers; those were removed from the UI.
// ============================================================

model CertificateTemplate {
  id         String  @id @default(cuid())
  name       String
  courseCode String?

  includeRanking Boolean @default(true)
  includeScore   Boolean @default(true)

  primaryColor  String  @default("#2A1B5D")
  accentColor   String  @default("#C21E9A")
  fontFamily    String  @default("Playfair Display")
  logoUrl       String? @db.Text // Store base64
  signatureUrl  String? @db.Text // Store base64
  signature2Url String? @db.Text // Store base64
  backgroundUrl String? @db.Text // Store base64
  sealEnabled   Boolean @default(true)
  qrPosition    String  @default("bottom-right")

  // Organization / signatories
  organizationName String @default("CODE EXCELLENCE EDUTECH")
  signatory1Name   String @default("Raina Bafna")
  signatory1Role   String @default("Founder")
  signatory2Name   String @default("Madhavi Patil")
  signatory2Role   String @default("Co-Founder")

  // Template versioning
  templateVersion Int       @default(1)
  isDraft         Boolean   @default(true)
  publishedAt     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // One template per course
  courseId String  @unique
  course   Courses @relation(fields: [courseId], references: [id], onDelete: Cascade)

  certificates Certificate[]

  @@map("certificate_templates")
}

// ============================================================
// USER — admin-side logins only (SUPER_ADMIN / SCHOOL_ADMIN /
// PARENT). Students are NOT Users — see the Student model below,
// which is the sole owner of enrollment/progress/certificates.
// ============================================================

model User {
  id        String    @id @default(cuid())
  name      String
  email     String   @unique
  password  String
  role      UserRole
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sessions Session[]

  @@map("users")
}

model Session {
  id        String    @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model Courses {
  id          String   @id @default(cuid())
  title       String
  description String?

  durationTypeId String?
  durationType   CourseDurationType? @relation(fields: [durationTypeId], references: [id])

  thumbnailUrl String?
  status       CourseStatus @default(Draft)
  createdBy    String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  levelId        String?
  categoryId     String?
  courseLevel    CourseLevel?    @relation(fields: [levelId], references: [id])
  courseCategory CourseCategory? @relation(fields: [categoryId], references: [id])

  modules             Modules[]
  enrollments         StudentCourseEnrollment[]
  grades              CourseGrade[]
  exams               Exam[]
  certificates        Certificate[]
  certificateTemplate CertificateTemplate?

  @@map("courses")
}

model CourseGrade {
  courseId String
  gradeId  String
  course   Courses @relation(fields: [courseId], references: [id], onDelete: Cascade)
  grade    Grade   @relation(fields: [gradeId], references: [id], onDelete: Cascade)

  @@id([courseId, gradeId])
  @@map("course_grades")
}

model Modules {
  id          String      @id @default(cuid())
  courseId    String
  title       String
  type        ModuleType @default(LESSON)
  order       Int
  description String?
  isActive    Boolean    @default(true)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  course Courses @relation(fields: [courseId], references: [id], onDelete: Cascade)

  lessons  Lessons[]
  revision Revision?
  quiz     Quiz?
  progress StudentModuleProgress[]

  @@unique([courseId, order])
  @@index([courseId])
  @@map("modules")
}

model Lessons {
  id          String       @id @default(cuid())
  moduleId    String
  title       String
  contentType ContentType
  fileUrl     String?
  order       Int
  isActive    Boolean     @default(true)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  module   Modules                 @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  progress StudentLessonProgress[]

  @@unique([moduleId, order])
  @@index([moduleId])
  @@map("lessons")
}

model AwardCategory {
  id        String   @id @default(cuid())
  name      String   @unique
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("award_categories")
}

model Revision {
  id        String   @id @default(cuid())
  moduleId  String   @unique
  title     String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  module   Modules           @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  contents RevisionContent[]

  @@map("revisions")
}

model RevisionContent {
  id          String               @id @default(cuid())
  revisionId  String
  contentType RevisionContentType
  fileUrl     String
  order       Int
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  revision Revision @relation(fields: [revisionId], references: [id], onDelete: Cascade)

  @@index([revisionId])
  @@map("revision_contents")
}

model Quiz {
  id           String    @id @default(cuid())
  moduleId     String   @unique
  passingMarks Int
  totalMarks   Int
  duration     Int?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  module    Modules              @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  questions Question[]
  attempts  StudentQuizAttempt[]

  @@map("quizzes")
}

model Question {
  id           String        @id @default(cuid())
  quizId       String
  question     String
  order        Int
  points       Int           @default(1)
  difficulty   Difficulty?
  bloomLevel   BloomLevel?
  questionType QuestionType?
  codeSnippet  String?       @db.Text
  codeLanguage String?
  explanation  String?       @db.Text

  inputMode     InputMode @default(text)
  questionImage String?   @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  quiz    Quiz                @relation(fields: [quizId], references: [id], onDelete: Cascade)
  options Option[]
  answers StudentQuizAnswer[]

  @@index([quizId])
  @@map("questions")
}

model Option {
  id         String    @id @default(cuid())
  questionId String
  text       String
  isCorrect  Boolean
  order      Int

  inputMode String? @default("text")
  imageData String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  question Question            @relation(fields: [questionId], references: [id], onDelete: Cascade)
  answers  StudentQuizAnswer[]

  @@index([questionId])
  @@map("options")
}

// ============================================================
// STUDENT — the sole owner of enrollment, progress, quiz
// attempts, and certificates. (User is admin-only; see above.)
// ============================================================

model Student {
  id            Int      @id @default(autoincrement())
  firstName     String
  middleName    String?
  lastName      String
  studentEmail  String?
  studentMobile String?
  username      String   @unique
  password      String
  parentMobile  String
  parentEmail   String?
  standard      String
  batch         String?
  status        String   @default("Active")
  schoolYear    String
  address       String?
  role          UserRole @default(STUDENT)
  createdAt     DateTime @default(now())

  enrollments    StudentCourseEnrollment[]
  moduleProgress StudentModuleProgress[]
  lessonProgress StudentLessonProgress[]
  quizAttempts   StudentQuizAttempt[]
  certificates   Certificate[]
 examAttempts     ExamAttempt[]      // NEW
  examCertificates ExamCertificate[]  // NEW
  @@map("students")
}

// ============================================================
// STUDENT — ENROLLMENT & PROGRESS
// ============================================================

model StudentCourseEnrollment {
  id         String     @id @default(cuid())
  studentId  Int
  courseId   String
  isActive   Boolean   @default(true)
  expiresAt  DateTime?
  enrolledAt DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  startDate DateTime?
  endDate   DateTime?

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  course  Courses @relation(fields: [courseId], references: [id], onDelete: Cascade)

  lessonProgress StudentLessonProgress[]
  quizAttempts   StudentQuizAttempt[]

  @@unique([studentId, courseId])
  @@index([studentId])
  @@index([courseId])
  @@map("student_course_enrollments")
}

model StudentModuleProgress {
  id          String    @id @default(cuid())
  studentId   Int
  moduleId    String
  isCompleted Boolean   @default(false)
  completedAt DateTime?
  updatedAt   DateTime  @updatedAt

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  module  Modules @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  @@unique([studentId, moduleId])
  @@index([studentId])
  @@index([moduleId])
  @@map("student_module_progress")
}

model StudentLessonProgress {
  id           String    @id @default(cuid())
  studentId    Int
  lessonId     String
  enrollmentId String?
  isCompleted  Boolean   @default(false)
  completedAt  DateTime?
  updatedAt    DateTime  @updatedAt

  student    Student                  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  lesson     Lessons                  @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  enrollment StudentCourseEnrollment? @relation(fields: [enrollmentId], references: [id])

  @@unique([studentId, lessonId])
  @@index([studentId])
  @@index([lessonId])
  @@map("student_lesson_progress")
}

model StudentQuizAttempt {
  id           String   @id @default(cuid())
  studentId    Int
  quizId       String
  enrollmentId String?
  score        Int
  isPassed     Boolean
  timeTaken    Int?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  student    Student                  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  quiz       Quiz                     @relation(fields: [quizId], references: [id], onDelete: Cascade)
  enrollment StudentCourseEnrollment? @relation(fields: [enrollmentId], references: [id])
  answers    StudentQuizAnswer[]

  @@unique([studentId, quizId])
  @@index([studentId])
  @@index([quizId])
  @@map("student_quiz_attempts")
}

model StudentQuizAnswer {
  id         String   @id @default(cuid())
  attemptId  String
  questionId String
  optionId   String
  isCorrect  Boolean
  createdAt  DateTime @default(now())

  attempt  StudentQuizAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  question Question           @relation(fields: [questionId], references: [id])
  option   Option             @relation(fields: [optionId], references: [id])

  @@index([attemptId])
  @@map("student_quiz_answers")
}

// ============================================================
// EXAMS SECTION
// ============================================================

model ExamSectionTemplate {
  id          String    @id @default(cuid())
  name        String
  description String?   @db.Text
  isActive    Boolean   @default(true)
  createdBy   String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  sections ExamSectionTemplateItem[]

  @@map("exam_section_templates")
}

model ExamSectionTemplateItem {
  id               String            @id @default(cuid())
  templateId       String
  title            String
  description      String?           @db.Text
  order            Int
  difficulty       ExamDifficulty
  questionType     ExamQuestionType?
  defaultMarks     Int
  defaultQuestions Int
  timeLimit        Int?

  template ExamSectionTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@unique([templateId, order])
  @@map("exam_section_template_items")
}

model Exam {
  id           String     @id @default(cuid())
  title        String
  description  String?    @db.Text
  courseId     String?
  examType     ExamType   @default(MOCK)
  totalMarks   Int        @default(0)
  passingMarks Int        @default(0)
  duration     Int
  status       ExamStatus @default(Draft)
  createdBy    String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  publishedAt  DateTime?

  maxAttempts        Int     @default(3)
  showAnswers        Boolean @default(false)
  showExplanations   Boolean @default(false)
  randomizeQuestions Boolean @default(false)
  requireProctoring  Boolean @default(false)

  startDate DateTime?
  endDate   DateTime?

  course    Courses?       @relation(fields: [courseId], references: [id], onDelete: SetNull)
  sections  ExamSection[]
  questions ExamQuestion[]
  attempts  ExamAttempt[]
examCertificates ExamCertificate[] 
  @@index([courseId])
  @@index([examType])
  @@index([status])
  @@map("exams")
}

model ExamSection {
  id           String            @id @default(cuid())
  examId       String
  title        String
  description  String?           @db.Text
  order        Int
  difficulty   ExamDifficulty
  questionType ExamQuestionType?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  exam          Exam               @relation(fields: [examId], references: [id], onDelete: Cascade)
  questions     ExamQuestion[]
  sectionScores ExamSectionScore[]

  @@unique([examId, order])
  @@index([examId])
  @@map("exam_sections")
}

model ExamQuestion {
  id               String            @id @default(cuid())
  examId           String
  sectionId        String?
  question         String            @db.Text
  inputMode        ExamInputMode     @default(text)
  questionImage    String?           @db.Text
  codeSnippet      String?           @db.Text
  codeLanguage     String?
  explanation      String?           @db.Text
  explanationImage String?           @db.Text
  points           Int               @default(1)
  difficulty       ExamDifficulty?
  bloomLevel       ExamBloomLevel?
  questionType     ExamQuestionType?
  order            Int
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  exam    Exam                @relation(fields: [examId], references: [id], onDelete: Cascade)
  section ExamSection?        @relation(fields: [sectionId], references: [id], onDelete: SetNull)
  options ExamOption[]
  answers ExamAttemptAnswer[]

  @@unique([examId, order])
  @@index([examId])
  @@index([sectionId])
  @@map("exam_questions")
}

model ExamOption {
  id         String        @id @default(cuid())
  questionId String
  text       String
  inputMode  ExamInputMode @default(text)
  imageData  String?       @db.Text
  isCorrect  Boolean
  order      Int
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  question ExamQuestion        @relation(fields: [questionId], references: [id], onDelete: Cascade)
  answers  ExamAttemptAnswer[]

  @@index([questionId])
  @@map("exam_options")
}

// NOTE: ExamAttempt.userId is left as a generic String? identifier for now.
// Exams weren't in scope of the Student/User schema fix — if you want exam
// results feeding into certificate grades later, point this at Student too
// (studentId Int?) the same way the models above were migrated.
model ExamAttempt {
  id          String    @id @default(uuid())
  examId      String
  userId      String?          // kept for backward compat, unused going forward
  studentId   Int?             // NEW — real FK to Student
  score       Int
  percentage  Float?
  isPassed    Boolean
  timeTaken   Int?
  startedAt   DateTime?
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  exam            Exam                @relation(fields: [examId], references: [id], onDelete: Cascade)
  student         Student?            @relation(fields: [studentId], references: [id], onDelete: Cascade) // NEW
  answers         ExamAttemptAnswer[]
  sectionScores   ExamSectionScore[]
  certificate     Certificate?
  examCertificate ExamCertificate?    // NEW

  @@index([examId])
  @@index([userId])
  @@index([studentId])              // NEW
  @@map("exam_attempts")
}

model ExamAttemptAnswer {
  id         String   @id @default(cuid())
  attemptId  String
  questionId String
  optionId   String
  isCorrect  Boolean
  timeSpent  Int?
  createdAt  DateTime @default(now())

  attempt  ExamAttempt  @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  question ExamQuestion @relation(fields: [questionId], references: [id])
  option   ExamOption   @relation(fields: [optionId], references: [id])

  @@index([attemptId])
  @@map("exam_attempt_answers")
}

model ExamSectionScore {
  id                String   @id @default(cuid())
  attemptId         String
  sectionId         String
  score             Int
  percentage        Float
  isPassed          Boolean?
  totalQuestions    Int
  correctlyAnswered Int
  createdAt         DateTime @default(now())

  attempt ExamAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  section ExamSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)

  @@unique([attemptId, sectionId])
  @@index([attemptId])
  @@map("exam_section_scores")
}

enum CertificateStatus {
  Issued
  Revoked
  Expired
}

model Certificate {
  id                String            @id @default(cuid())
  certificateNumber String            @unique

  score      Int
  percentage Float
  grade      String
  status     CertificateStatus @default(Issued)

  issuedAt      DateTime  @default(now())
  expiresAt     DateTime?
  revokedAt     DateTime?
  revokedReason String?

  qrCodeUrl       String?
  verificationUrl String?
  pdfUrl          String?

  // Snapshots so the certificate content never changes even if the
  // student/course is renamed later.
  studentNameSnapshot String
  courseNameSnapshot  String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  studentId Int
  student   Student @relation(fields: [studentId], references: [id])

  courseId String
  course   Courses @relation(fields: [courseId], references: [id])

  templateId String
  template   CertificateTemplate @relation(fields: [templateId], references: [id])

  examAttemptId String?      @unique
  examAttempt   ExamAttempt? @relation(fields: [examAttemptId], references: [id])

  @@unique([studentId, courseId]) // one certificate per student per course
  @@index([studentId])
  @@index([courseId])
  @@index([templateId])
  @@map("certificates")
}
model AchievementCertificate {
  id              String   @id @default(cuid())
  certificateName String   @db.VarChar(150)
  designation     String   @db.VarChar(150)
  colorCode       String   @db.VarChar(7) 
  percentFrom     Float    
  percentTo       Float
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  examCertificates ExamCertificate[] 

  @@unique([certificateName])
  @@index([percentFrom, percentTo])
  @@map("achievement_certificates")
}
model ExamCertificate {
  id                String   @id @default(cuid())
  certificateNumber String   @unique

  score      Int
  percentage Float
  isPassed   Boolean

  // Snapshot of the band at issue time, so it never changes even if
  // an admin edits/deletes the band later.
  certificateName String
  designation     String
  colorCode       String

  studentNameSnapshot String
  examTitleSnapshot   String

  issuedAt  DateTime @default(now())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  studentId Int
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  examId String
  exam   Exam   @relation(fields: [examId], references: [id], onDelete: Cascade)

  attemptId String      @unique
  attempt   ExamAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)

  bandId String?
  band   AchievementCertificate? @relation(fields: [bandId], references: [id], onDelete: SetNull)

  @@index([studentId])
  @@index([examId])
  @@map("exam_certificates")
}